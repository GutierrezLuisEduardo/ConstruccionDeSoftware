<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="utf-8">
<title>Formularios HTML Dinámico</title>
<style>
body { font-family: sans-serif; margin: 42px; }
pre { background: #242424; padding: 24px; border-radius: 6px; }
.resultado { margin-top: 24px; border-top: 4px solid #ccc; padding-top: 24px; }
</style>
</head>
<body>
<h1>Contenido repetido</h1>

<%- include("form.ejs") %>

<% if (contenido) { %>
    <div class="resultado">
    <h2>Resultado:</h2>
    <p><strong>Índice:</strong> <%= indice %> | <strong>Texto:</strong> "<%= imprimir %>"</p>
    <pre><%= contenido %></pre>
    </div>
    <% } %>

</body>
</html>
