<!DOCTYPE HTML>
<html>
<head>
    <%- include('./../css.ejs') %>
</head>
<body>
    <h1><%= title %></h1>
    <ul>
        <% usuarios.forEach(function(user) { %>
            <li><%= user.nombre %></li>
        <% }); %>
    </ul>
    <ul>
        <% alertas.forEach(function(alerta) { %>
            <li><%= alerta.titulo %></li>
        <% }); %>
    </ul>
    <a href="/usuarios/agregar_usuario">Agregar nuevo usuario</a>
    <br><br>
    <a href="/usuarios/eliminar_usuario">Eliminar usuario</a>
</body>
<%- include('./../scripts.ejs') %>
</html>
